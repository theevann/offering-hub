generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OfferingCategory {
  CLASS // Structured recurring sessions (yoga, language, etc.)
  RETREAT // Multi-day immersive experiences
  WORKSHOP // One-off educational events
  GATHERING // Social events, markets, meetups
  SERVICE // Ongoing offerings (therapy, coaching)
  SALE // Items for sale
  RENTAL // Items for rent
  OTHER // Doesn't fit other categories
}

enum ParseStatus {
  PENDING // Not yet processed
  PROCESSING // Currently being parsed
  PARSED_OK // Successfully parsed into Offering
  PARSED_PARTIAL // Parsed but missing key fields (e.g. no date)
  PARSED_NOOP // Parsed but determined to be non-offering (e.g. just a chat message)
  DUPLICATE // Matches an existing offering
  // PARSED_DUPLICATE // Matches an existing offering after parsing
  FAILED // Parsing failed, check parseError
}

enum GroupType {
  COUNTRY
  REGION
  CITY
  VENUE
  CHAT
}

enum AliasSource {
  MANUAL
  GOOGLE_MAPS_URL
  FUZZY_MATCH  // For now, deprecated (we do not do fuzzy matching in the current system)
  GOOGLE_QUERY_CACHE
  GOOGLE_PLACE
}

enum MediaType {
  IMAGE
}

enum LocationSource {
  GOOGLE_MAPS_URL
  ALIAS_MATCH
  GOOGLE_QUERY_CACHE
  GOOGLE_PLACE
  GROUP_FALLBACK
  UNKNOWN
}

model Group {
  id         String @id @default(cuid())
  sourceId String @unique // WhatsApp's internal group ID
  name       String // Human-readable name

  type GroupType

  // Location context (manually configured)
  country   String // e.g., "India", "Indonesia"
  adminArea String? // e.g., "Goa", "Bali"
  city      String // e.g., "Arambol", "Ubud"
  timezone  String? // e.g., "Asia/Kolkata", "Asia/Bali"
  language  String? // e.g., "en", "hi", "id"

  // Rough geolocation for the group
  latitude  Float?
  longitude Float?
  location     Unsupported("geography(Point,4326)")?
  radiusKm  Float? // Max is 50 km per API spec

  // Status
  active Boolean @default(true)

  // Venue if applicable
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rawMessages RawMessage[]
  offerings   Offering[]

  @@index([country])
  @@index([city])
}

model Venue {
  id String @id @default(cuid())

  displayName    String
  normalizedName String

  address String?
  city     String?
  adminArea String?
  country  String?

  latitude  Float
  longitude Float
  location     Unsupported("geography(Point,4326)")?

  googlePlaceId String? @unique
  mapsUrl       String?

  aliases VenueAlias[]

  groups    Group[]
  offerings Offering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VenueAlias {
  id String @id @default(cuid())

  alias           String
  normalizedAlias String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  source     AliasSource
  confidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, normalizedAlias]) // Could happen that two different venues have the same alias, eg in different countries
  @@index([source, normalizedAlias]) // Google query lookup has no venue/geography scope.
}

model RawMessage {
  id     String @id @default(cuid())
  source String @default("whatsapp")

  // WhatsApp metadata
  messageId   String?   @unique
  senderId    String
  groupId     String?
  senderPhone String?
  senderName  String?
  timestamp   DateTime?

  // Content
  rawText     String
  contentHash String?

  // Processing state
  parsingModel  String?
  parsingStatus ParseStatus @default(PENDING)
  parsingNotes  String?

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  offerings Offering[]
  group     Group?     @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([parsingStatus])
  @@index([createdAt])
  @@index([contentHash, createdAt])
}

model Media {
  id String @id @default(cuid())

  type MediaType

  url      String
  mimeType String?

  rawMessageId String
  rawMessage   RawMessage @relation(fields: [rawMessageId], references: [id])

  offerings Offering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offering {
  id          String           @id @default(cuid())
  category    OfferingCategory
  title       String
  description String?
  startTime   DateTime? // Full timestamp combining date + start time (timezone-aware)
  endTime     DateTime? // Full timestamp combining date + end time (timezone-aware)
  startTimePrecision String? // one of "unknown", "wholeDay", "fixedTime" (use "unknown" if no time is mentioned, "wholeDay" if the message implies an all-day event, and "fixedTime" if a specific time is mentioned)
  pricingType String? // e.g. "free", "fixed", "donation", "range"
  price       Json? // Flexible pricing info (e.g. { "amount": 10, "currency": "USD" })

  locationSource LocationSource
  locationText   String? // Freeform extracted location text (e.g. "Arambol beach")
  latitude       Float? // Geocoded latitude
  longitude      Float? // Geocoded longitude
  location     Unsupported("geography(Point,4326)")?

  // Optional relation to a known venue
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Contextual group info
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  // Original message reference
  rawMessageId String
  rawMessage   RawMessage @relation(fields: [rawMessageId], references: [id])

  media Media[]
  links Json? // Extracted links from the message (e.g. [{ "url": "https://example.com", "type": "registration" }])
  contactInfo Json? // TODO: Extracted contact info (e.g. [{ "type": "phone", "value": "+1234567890" }])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime? @default(dbgenerated("now() + interval '7 days'"))
  
  @@index([rawMessageId])
}
