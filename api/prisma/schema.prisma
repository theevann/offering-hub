generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OfferingCategory {
  CLASS // Structured recurring sessions (yoga, language, etc.)
  RETREAT // Multi-day immersive experiences
  WORKSHOP // One-off educational events
  GATHERING // Social events, markets, meetups
  SERVICE // Ongoing offerings (therapy, coaching)
  SALE // Items for sale
  RENTAL // Items for rent
  OTHER // Doesn't fit other categories
}

enum ParseStatus {
  PARSED_OK // Successfully parsed into Offering
  PARSED_PARTIAL // Parsed but missing key fields (e.g. no date)
  PARSED_NOOP // Parsed but determined to be non-offering (e.g. just a chat message)
  FAILED // Parsing failed, check parseError
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GroupType {
  COUNTRY
  REGION
  CITY
  VENUE
  CHAT
}

enum AliasSource {
  MANUAL
  GOOGLE_MAPS_URL
  GOOGLE_QUERY_CACHE
  GOOGLE_PLACE
}

enum MediaType {
  IMAGE
}

enum LocationSource {
  GOOGLE_MAPS_URL
  ALIAS_MATCH
  GOOGLE_QUERY_CACHE
  GOOGLE_PLACE
  GOOGLE_ADDRESS
  GOOGLE_AREA
  GROUP_FALLBACK
  UNKNOWN
}

enum LocationMode {
  online
  at_provider
  at_customer
  unknown
}

model Group {
  id         String @id @default(cuid())
  sourceId String @unique // WhatsApp's internal group ID
  name       String // Human-readable name

  type GroupType

  // Location context (manually configured)
  country   String // e.g., "India", "Indonesia"
  adminArea String? // e.g., "Goa", "Bali"
  city      String // e.g., "Arambol", "Ubud"
  timezone  String? // e.g., "Asia/Kolkata", "Asia/Bali"
  language  String? // e.g., "en", "hi", "id"

  // Rough geolocation for the group
  latitude  Float?
  longitude Float?
  location     Unsupported("geography(Point,4326)")?
  radiusKm  Float? // Max is 50 km per API spec

  // Status
  active Boolean @default(true)

  // Venue if applicable
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rawMessages    RawMessage[]
  offerings      Offering[]
  processingJobs ProcessingJob[]

  @@index([country])
  @@index([city])
}

model Venue {
  id String @id @default(cuid())

  displayName    String
  normalizedName String

  address String?
  city     String?
  adminArea String?
  country  String?

  latitude  Float
  longitude Float
  location     Unsupported("geography(Point,4326)")?

  googlePlaceId String? @unique
  mapsUrl       String?

  aliases VenueAlias[]

  groups    Group[]
  offerings Offering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VenueAlias {
  id String @id @default(cuid())

  alias           String
  normalizedAlias String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  source     AliasSource
  confidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, normalizedAlias]) // Could happen that two different venues have the same alias, eg in different countries
  @@index([source, normalizedAlias]) // Google query lookup has no venue/geography scope.
}

model ProcessingJob {
  id             String           @id @default(cuid())
  source         String           @default("whatsapp")
  senderId       String
  groupId        String?
  group          Group?           @relation(fields: [groupId], references: [id])

  status         ProcessingStatus @default(PENDING)
  scheduledAt    DateTime         @default(now())
  firstMessageAt DateTime         @default(now())
  lastMessageAt  DateTime         @default(now())

  combinedText   String           @default("")
  parsingModel   String?
  parsingStatus  ParseStatus?
  parsingNotes   String?
  rawParsedJson  Json?
  attempts       Int              @default(0)
  lastError      String?

  rawMessages    RawMessage[]
  offerings      Offering[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, scheduledAt])
  @@index([source, senderId, groupId, status])
  @@index([groupId])
}

model RawMessage {
  id     String @id @default(cuid())
  source String @default("whatsapp")

  // WhatsApp metadata
  messageId   String?   @unique
  senderId    String
  groupId     String?
  senderPhone String?
  senderName  String?
  timestamp   DateTime?

  // Content
  rawText     String
  contentHash String?

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  processingJobId String?
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id])
  group           Group?         @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([createdAt])
  @@index([processingJobId, createdAt])
  @@index([contentHash, createdAt])
}

model Media {
  id String @id @default(cuid())

  type MediaType

  url      String
  mimeType String?

  rawMessageId String
  rawMessage   RawMessage @relation(fields: [rawMessageId], references: [id])

  offerings Offering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offering {
  id          String           @id @default(cuid())
  category    OfferingCategory
  topics      String[]
  title       String
  summary     String?
  description String?
  startTime   DateTime? // Full timestamp combining date + start time (timezone-aware)
  endTime     DateTime? // Full timestamp combining date + end time (timezone-aware)
  startTimePrecision String? // one of "unknown", "wholeDay", "fixedTime" (use "unknown" if no time is mentioned, "wholeDay" if the message implies an all-day event, and "fixedTime" if a specific time is mentioned)
  pricingType String? // e.g. "free", "fixed", "donation", "range"
  price       Json? // Flexible pricing info (e.g. { "amount": 10, "currency": "USD" })

  locationSource LocationSource
  locationModes   LocationMode[]
  locationText   String? // Freeform extracted location text (e.g. "Arambol beach")
  latitude       Float? // Geocoded latitude
  longitude      Float? // Geocoded longitude
  location     Unsupported("geography(Point,4326)")?

  // Optional relation to a known venue
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Contextual group info
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  // Processing run reference
  processingJobId String
  processingJob   ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)

  media Media[]
  resources Json @default("[]") // [{ value, channel, purposes: [] }]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime? @default(dbgenerated("now() + interval '7 days'"))
  
  @@index([processingJobId])
}
